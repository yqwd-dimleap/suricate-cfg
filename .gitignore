# ===== suricate-cfg 部署仓：运行时与密钥一律不进 git =====

# 密钥与本机环境（从 env.sh.example 复制）
env.sh
config/api_key.txt
config/*.pem
config/*.key
*.key
*.pem

# Agent 持久化数据（容器挂载，体积大且含密钥/会话）
.suricate/
**/.suricate/
# legacy path before rename
.openhands/
**/.openhands/

# 运行产物
logs/
run/
*.log
*.pid

# 工作区与演示产出（可按需取消忽略 demo 源码）
projects/
# demo/ 若只保留示例源码可提交；忽略本地实验产物：
demo/**/__pycache__/
demo/**/*.pyc

# 备份与临时
*.bak
*.bak-*
*.backup
*~
*.swp
.settings.json.bak*
workspaces.json.bak*

# 节点/运维笔记与一次性 prompt（含内网 IP、机器清单）— 不进仓
nodes/
REMOTE_NODE_*.md
PROMPT_FOR_*.md
*_CHECKLIST.md
GIT_COMMIT_MAP.md
MAC_CLIENT.md

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.code-workspace

# Python / Node 误入
__pycache__/
node_modules/
.venv/
venv/
