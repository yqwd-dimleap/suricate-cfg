#!/usr/bin/env bash
# Suricate / OpenHands Agent Canvas — 部署环境模板（可提交）
# 用法：cp env.sh.example env.sh 后填真实密钥；env.sh 不进 git
# Layout 默认：/data/openhands（可用 symlink 指到 suricate-cfg 仓目录）

export OPENHANDS_ROOT="${OPENHANDS_ROOT:-/data/openhands}"
export OPENHANDS_PROJECTS="${OPENHANDS_ROOT}/projects"
export OPENHANDS_DEMO="${OPENHANDS_ROOT}/demo"
export OPENHANDS_LOG_DIR="${OPENHANDS_ROOT}/logs"
export OPENHANDS_RUN_DIR="${OPENHANDS_ROOT}/run"
export HOME_OPENHANDS="${OPENHANDS_ROOT}/.openhands"

# docker-host | docker-bridge | npm
export OPENHANDS_MODE="${OPENHANDS_MODE:-docker-host}"
export OPENHANDS_UID="${OPENHANDS_UID:-0}"
export OPENHANDS_GID="${OPENHANDS_GID:-0}"
export OPENHANDS_CONTAINER_NAME="${OPENHANDS_CONTAINER_NAME:-openhands-canvas}"
export OPENHANDS_IMAGE="${OPENHANDS_IMAGE:-ghcr.io/openhands/agent-canvas:1.16.0}"

export PORT="${PORT:-8011}"
export OPENHANDS_PORT="${OPENHANDS_PORT:-8011}"

# CORS（总控浏览器来源按需改）
export OH_ALLOW_CORS_ORIGINS_0="${OH_ALLOW_CORS_ORIGINS_0:-https://agent.dimleap.cn}"
export OH_ALLOW_CORS_ORIGINS_1="${OH_ALLOW_CORS_ORIGINS_1:-http://127.0.0.1:8011}"
export OH_ALLOW_CORS_ORIGINS_2="${OH_ALLOW_CORS_ORIGINS_2:-http://localhost:8011}"
export OH_ALLOW_CORS_ORIGINS_3="${OH_ALLOW_CORS_ORIGINS_3:-http://localhost:5173}"
export OH_ALLOW_CORS_ORIGIN_REGEX="${OH_ALLOW_CORS_ORIGIN_REGEX:-https?://(agent\\.dimleap\\.cn|localhost|127\\.0\\.0\\.1)(:[0-9]+)?}"

# 必填：每个节点自己生成，勿提交真实值
export LOCAL_BACKEND_API_KEY="${LOCAL_BACKEND_API_KEY:-<set-me>}"
export OH_SECRET_KEY="${OH_SECRET_KEY:-<set-me>}"

# LLM（按节点改；示例为占位）
export LLM_BASE_URL="${LLM_BASE_URL:-http://127.0.0.1:8005/v1}"
export LLM_API_KEY="${LLM_API_KEY:-sk-local}"
export LLM_MODEL="${LLM_MODEL:-openai/qwen3-coder-next}"

# 浏览器：跳过从外网拉 uBlock 等扩展（国内易超时）
export BROWSER_USE_DISABLE_EXTENSIONS="${BROWSER_USE_DISABLE_EXTENSIONS:-1}"
